{
  "name": "tools-subs-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop app to track tools, subscriptions, and one-time purchases.",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build --config vite.config.web.ts",
    "preview:web": "vite preview --config vite.config.web.ts",
    "dev:e2e": "vite --config vite.config.e2e.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "test": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json --noEmit",
    "package": "npm run build && electron-builder"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "tar": ">=7.5.11",
    "tmp": ">=0.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.107.0",
    "@types/node": "^22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "electron": "^42.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "framer-motion": "^12.40.0",
    "globals": "^15.15.0",
    "lucide-react": "^0.469.0",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.14",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.76.0",
    "recharts": "^3.8.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "zod": "^3.25.76"
  }
}
