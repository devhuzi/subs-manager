# Tools & Subs Manager — environment template. Copy to `.env` and fill in.
# The DESKTOP (Electron) app needs no runtime secrets. These vars are only for
# the WEB (PWA) build, which talks to Supabase.

# Web PWA — Supabase project (safe to expose; the anon/publishable key is
# public by design and is protected by Row-Level Security). Vite inlines any
# VITE_-prefixed var into the frontend bundle at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Web Push: the PUBLIC half of your VAPID keypair (safe to expose). Generate with
# `npx web-push generate-vapid-keys`. The private half goes in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: links to your own legal pages, shown on the sign-in screen and in
# Settings. Leave empty to hide them (fine for a private, self-hosted instance).
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# --- Server-side only (NEVER commit real values; set in Supabase, not here) ---
# Used by Edge Functions, configured via `supabase secrets set`, not the frontend:
#   ALLOWED_ORIGINS            # REQUIRED in prod: comma-separated app origins for CORS
#                              #   (unset → only localhost dev servers are allowed)
#   OPENROUTER_REFERER         # optional HTTP-Referer attribution for OpenRouter
#   VAPID_PUBLIC_KEY           # Web Push (Phase 4) — public half also exposed to client
#   VAPID_PRIVATE_KEY          # Web Push signing — secret
#   VAPID_SUBJECT              # mailto: contact for push, e.g. mailto:you@example.com
